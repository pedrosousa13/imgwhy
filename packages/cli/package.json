{
  "name": "imgwhy",
  "version": "0.0.0",
  "description": "Explain which file a browser downloads from a srcset, and why.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "imgwhy": "./dist/bin.js"
  },
